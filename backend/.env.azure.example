# ==========================================
# CONFIGURACIÓN PARA MICROSOFT AZURE
# ==========================================
# Este archivo contiene las variables de entorno para deployment en Azure
# 
# INSTRUCCIONES:
# 1. Copiar este archivo a .env.azure
# 2. Actualizar los valores según tu deployment en Azure
# 3. En Azure App Service, configurar estas variables en "Configuration" → "Application settings"
#
# IMPORTANTE:
# - NO commitear .env.azure con credenciales reales
# - Usar Azure Key Vault para secrets sensibles en producción
# ==========================================

# ========== APLICACIÓN ==========
APP_NAME="Sistema de Asistencias"
APP_ENV=production
APP_KEY=base64:GENERAR_NUEVA_KEY_CON_php_artisan_key:generate
APP_DEBUG=false
APP_URL=https://tu-app.azurewebsites.net
APP_TIMEZONE=America/La_Paz

# Locale
APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_ES

# ========== BASE DE DATOS - AZURE DATABASE FOR POSTGRESQL ==========
# Opciones:
# 1. Azure Database for PostgreSQL Flexible Server (Recomendado)
# 2. PostgreSQL en Container Instance
# 3. PostgreSQL en Virtual Machine

DB_CONNECTION=pgsql
DB_HOST=tu-servidor.postgres.database.azure.com
DB_PORT=5432
DB_DATABASE=examen2_db
DB_USERNAME=adminuser@tu-servidor
DB_PASSWORD=TuPasswordSeguro123!
# SSL requerido en Azure Database for PostgreSQL
DB_SSLMODE=require

# ========== AZURE APP SERVICE ==========
# Estas variables se configuran automáticamente en Azure App Service
# pero puedes override si es necesario

# URL del sitio (Azure lo configura automáticamente)
# WEBSITE_HOSTNAME=tu-app.azurewebsites.net

# Puerto del contenedor (Azure lo configura en 8000)
# WEBSITES_PORT=8000

# ========== PROXY & NETWORKING ==========
# CRÍTICO: Azure Application Gateway actúa como proxy reverso
# Laravel necesita confiar en estos proxies para detectar la IP real del cliente

# Confiar en todos los proxies de Azure (ya configurado en código)
# El middleware TrustProxies está configurado con '*'

# ========== LOGS & MONITORING ==========
LOG_CHANNEL=stack
LOG_STACK=daily
LOG_LEVEL=info
LOG_DEPRECATIONS_CHANNEL=null

# Azure Application Insights (opcional pero recomendado)
# APPINSIGHTS_INSTRUMENTATIONKEY=tu-instrumentation-key

# ========== CACHE & SESSION ==========
# Opciones para Azure:
# 1. Azure Cache for Redis (Recomendado para producción)
# 2. Database (Más simple pero menos performante)

# Opción 1: Azure Cache for Redis
CACHE_STORE=redis
SESSION_DRIVER=redis
REDIS_CLIENT=phpredis
REDIS_HOST=tu-cache.redis.cache.windows.net
REDIS_PASSWORD=TuPasswordRedis
REDIS_PORT=6380
REDIS_SCHEME=tls

# Opción 2: Database (más simple para empezar)
# CACHE_STORE=database
# SESSION_DRIVER=database

SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

# ========== QUEUE & JOBS ==========
# Opciones para Azure:
# 1. Azure Service Bus (Enterprise)
# 2. Azure Queue Storage (Económico)
# 3. Database (Simple)

QUEUE_CONNECTION=database
# Para Azure Service Bus:
# QUEUE_CONNECTION=azure

# ========== MAIL ==========
# Opciones para Azure:
# 1. Azure Communication Services (Recomendado)
# 2. SendGrid
# 3. Mailgun

MAIL_MAILER=smtp
MAIL_HOST=smtp.sendgrid.net
MAIL_PORT=587
MAIL_USERNAME=apikey
MAIL_PASSWORD=TuApiKeySendGrid
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS="noreply@tu-dominio.com"
MAIL_FROM_NAME="${APP_NAME}"

# ========== STORAGE ==========
# Opciones para Azure:
# 1. Azure Blob Storage (Recomendado)
# 2. Local filesystem (para testing)

FILESYSTEM_DISK=azure
# Para Azure Blob Storage:
AZURE_STORAGE_ACCOUNT_NAME=tucuentastorage
AZURE_STORAGE_ACCOUNT_KEY=TuKeyStorage
AZURE_STORAGE_CONTAINER=archivos

# ========== CORS ==========
# Configurar según tu frontend deployment
# IMPORTANTE: En producción, especificar SOLO los dominios permitidos
CORS_ALLOWED_ORIGINS=https://tu-frontend.azurewebsites.net,https://tu-dominio.com

# ========== SANCTUM ==========
# Dominios que recibirán cookies de sesión stateful
# IMPORTANTE: Incluir SOLO dominios de confianza
SANCTUM_STATEFUL_DOMAINS=tu-frontend.azurewebsites.net,tu-dominio.com

# SESSION_DOMAIN debe ser compartido entre frontend y backend
SESSION_DOMAIN=.azurewebsites.net

# ========== SECURITY ==========
# Azure maneja SSL/TLS automáticamente
FORCE_HTTPS=true

# ========== MONITORING & HEALTH CHECK ==========
# Azure App Service tiene health checks integrados
# Endpoint: /up (configurado en routes/web.php)

# ========== BCRYPT ==========
BCRYPT_ROUNDS=12

# ==========================================
# CHECKLIST PARA DEPLOYMENT EN AZURE
# ==========================================
# 
# ✅ ANTES DE SUBIR:
# [ ] Cambiar APP_ENV=production
# [ ] Cambiar APP_DEBUG=false
# [ ] Generar nuevo APP_KEY
# [ ] Configurar base de datos PostgreSQL en Azure
# [ ] Configurar variables de entorno en Azure App Service
# [ ] Configurar CORS para tu dominio frontend
# [ ] Habilitar SSL (Azure lo hace automáticamente)
# [ ] Configurar Azure Cache for Redis (opcional pero recomendado)
# 
# ✅ DESPUÉS DE SUBIR:
# [ ] Ejecutar migraciones: php artisan migrate --force
# [ ] Ejecutar seeders si es necesario: php artisan db:seed --force
# [ ] Verificar logs en Azure Portal → Log stream
# [ ] Probar health check: https://tu-app.azurewebsites.net/up
# [ ] Verificar bitácora registra IP real del cliente
# [ ] Configurar Application Insights para monitoreo
# [ ] Configurar alertas de disponibilidad
# [ ] Configurar backup automático de base de datos
#
# ==========================================
# COMANDOS ÚTILES PARA AZURE
# ==========================================
#
# Ver logs en tiempo real:
# az webapp log tail --name tu-app --resource-group tu-grupo
#
# SSH al container:
# az webapp ssh --name tu-app --resource-group tu-grupo
#
# Restart de la app:
# az webapp restart --name tu-app --resource-group tu-grupo
#
# Ver configuración:
# az webapp config appsettings list --name tu-app --resource-group tu-grupo
#
# ==========================================
